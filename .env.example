# Copy this file to .env and fill in real values.
# .env is gitignored — never commit real secrets to this file's tracked counterpart.
# These are consumed at build time via `--dart-define-from-file=.env` (see lib/core/config/env.dart).
#
# Cashfree credentials (CASHFREE_APP_ID / CASHFREE_SECRET_KEY) are NOT
# configured here. They live only as Supabase Edge Function secrets
# (`supabase secrets set`) and are never read by the Flutter client.

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
OLA_MAPS_API_KEY=your-ola-maps-api-key
