diff --git a/test/phase1_earnings_requests_test.dart b/test/phase1_earnings_requests_test.dart
new file mode 100644
index 0000000..6bdce18 100644
--- /dev/null
+++ b/test/phase1_earnings_requests_test.dart
@@ -0,0 +1,164 @@
+import 'dart:async';
+import 'dart:convert';
+import 'package:flutter/material.dart';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:http/http.dart' as http;
+import 'package:http/testing.dart';
+import 'package:supabase_flutter/supabase_flutter.dart';
+import 'package:waydrop/core/services/realtime/realtime_manager.dart';
+import 'package:waydrop/features/rider/earnings/rider_earnings_tab.dart';
+
+class _QuietChannel extends RealtimeChannel {
+  _QuietChannel(String name)
+    : super(name, RealtimeClient('wss://example.invalid/realtime/v1'));
+  @override
+  RealtimeChannel subscribe([
+    void Function(RealtimeSubscribeStatus, Object?)? callback,
+    Duration? timeout,
+  ]) {
+    callback?.call(RealtimeSubscribeStatus.subscribed, null);
+    return this;
+  }
+}
+
+class _Client extends SupabaseClient {
+  _Client(http.Client client)
+    : super(
+        'https://example.invalid',
+        'test-public-key',
+        httpClient: client,
+        authOptions: const AuthClientOptions(autoRefreshToken: false),
+      );
+  @override
+  RealtimeChannel channel(
+    String name, {
+    RealtimeChannelConfig opts = const RealtimeChannelConfig(),
+  }) => _QuietChannel(name);
+  @override
+  Future<String> removeChannel(RealtimeChannel channel) async => 'ok';
+}
+
+void main() {
+  TestWidgetsFlutterBinding.ensureInitialized();
+  _Client? allocatedClient;
+  tearDown(() async {
+    await allocatedClient?.dispose();
+  });
+  testWidgets(
+    'Earnings shares an in-flight batch and stops new queries after disposal',
+    (tester) async {
+      final requests = <http.Request>[];
+      final riderGate = Completer<http.Response>();
+      String encode(Object v) =>
+          base64Url.encode(utf8.encode(jsonEncode(v))).replaceAll('=', '');
+      const uid = '00000000-0000-4000-8000-000000000021';
+      final token = [
+        encode({'alg': 'HS256', 'typ': 'JWT'}),
+        encode({
+          'sub': uid,
+          'role': 'authenticated',
+          'exp':
+              DateTime.now()
+                  .add(const Duration(hours: 1))
+                  .millisecondsSinceEpoch ~/
+              1000,
+        }),
+        'test',
+      ].join('.');
+      final client = (await tester.runAsync(
+        () async => _Client(
+          MockClient((request) async {
+            requests.add(request);
+            Object? body;
+            if (request.url.path.contains('/auth/')) {
+              body = {
+                'access_token': token,
+                'refresh_token': 'test',
+                'expires_in': 3600,
+                'token_type': 'bearer',
+                'user': {
+                  'id': uid,
+                  'aud': 'authenticated',
+                  'created_at': '2026-01-01T00:00:00Z',
+                  'app_metadata': <String, dynamic>{},
+                  'user_metadata': <String, dynamic>{},
+                },
+              };
+            } else if (request.url.path.endsWith('/riders')) {
+              final result = await riderGate.future;
+              return http.Response(
+                result.body,
+                result.statusCode,
+                request: request,
+                headers: {'content-type': 'application/json'},
+              );
+            } else if (request.url.path.endsWith('/government_tax_config')) {
+              body = null;
+            } else if (request.url.path.endsWith('/create-rider-withdrawal')) {
+              body = {'success': true};
+            } else {
+              throw StateError(
+                'Unexpected request after disposal: ${request.url.path}',
+              );
+            }
+            return http.Response(
+              jsonEncode(body),
+              200,
+              request: request,
+              headers: {'content-type': 'application/json'},
+            );
+          }),
+        ),
+      ))!;
+      allocatedClient = client;
+      final manager = RealtimeManager.forClient(client);
+      try {
+        await tester.runAsync(() => client.auth.setSession('test-refresh'));
+        await tester.pumpWidget(
+          MaterialApp(
+            home: RiderEarningsTab(client: client, realtime: manager),
+          ),
+        );
+        await tester.runAsync(
+          () => Future<void>.delayed(const Duration(milliseconds: 30)),
+        );
+        final dynamic state = tester.state(find.byType(RiderEarningsTab));
+        final Future<void> second = state.fetchData();
+        final Future<void> third = state.fetchData();
+        await tester.runAsync(
+          () => Future<void>.delayed(const Duration(milliseconds: 30)),
+        );
+        expect(requests.where((r) => r.url.path.endsWith('/riders')).length, 1);
+        expect(
+          requests
+              .where((r) => r.url.path.endsWith('/government_tax_config'))
+              .length,
+          1,
+        );
+
+        await tester.pumpWidget(const SizedBox());
+
+        riderGate.complete(http.Response(jsonEncode({'id': 'rider-a'}), 200));
+
+        var secondDone = false;
+        var thirdDone = false;
+        second.then((_) => secondDone = true);
+        third.then((_) => thirdDone = true);
+        for (var i = 0; i < 4; i++) {
+          await tester.runAsync(
+            () => Future<void>.delayed(const Duration(milliseconds: 30)),
+          );
+          await tester.pump();
+        }
+
+        expect(secondDone, isTrue);
+        expect(thirdDone, isTrue);
+        expect(requests.where((r) => r.url.path.endsWith('/orders')).length, 0);
+        expect(manager.activeChannelCount, 0);
+        expect(tester.takeException(), isNull);
+      } finally {
+        manager.dispose();
+      }
+    },
+  );
+}
diff --git a/test/phase1_gps_completion_test.dart b/test/phase1_gps_completion_test.dart
new file mode 100644
index 0000000..2de644f 100644
--- /dev/null
+++ b/test/phase1_gps_completion_test.dart
@@ -0,0 +1,85 @@
+import 'dart:async';
+import 'package:http/http.dart' as http;
+import 'package:http/testing.dart';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:geolocator/geolocator.dart';
+import 'package:shared_preferences/shared_preferences.dart';
+import 'package:supabase_flutter/supabase_flutter.dart';
+import 'package:waydrop/core/services/location/location_cache_service.dart';
+
+class _ClosingGps extends GeolocatorPlatform {
+  var positions = StreamController<Position>.broadcast();
+  final status = StreamController<ServiceStatus>.broadcast();
+  int starts = 0;
+  @override
+  Future<bool> isLocationServiceEnabled() async => true;
+  @override
+  Future<LocationPermission> checkPermission() async =>
+      LocationPermission.whileInUse;
+  @override
+  Future<Position?> getLastKnownPosition({
+    bool forceLocationManager = false,
+  }) async => Position(
+    latitude: 17,
+    longitude: 79,
+    timestamp: DateTime.now(),
+    accuracy: 2,
+    altitude: 0,
+    altitudeAccuracy: 0,
+    heading: 0,
+    headingAccuracy: 0,
+    speed: 0,
+    speedAccuracy: 0,
+  );
+  @override
+  Stream<Position> getPositionStream({LocationSettings? locationSettings}) {
+    starts++;
+    return positions.stream;
+  }
+
+  @override
+  Stream<ServiceStatus> getServiceStatusStream() => status.stream;
+}
+
+void main() {
+  TestWidgetsFlutterBinding.ensureInitialized();
+  test(
+    'normal GPS stream completion releases its handle so tracking can restart',
+    () async {
+      SharedPreferences.setMockInitialValues({});
+      final original = GeolocatorPlatform.instance;
+      final gps = _ClosingGps();
+      GeolocatorPlatform.instance = gps;
+      await Supabase.initialize(
+        url: 'https://example.invalid',
+        anonKey: 'test-public-key',
+        httpClient: MockClient(
+          (request) async => http.Response(
+            '[]',
+            200,
+            request: request,
+            headers: {'content-type': 'application/json'},
+          ),
+        ),
+        authOptions: const FlutterAuthClientOptions(autoRefreshToken: false),
+      );
+      try {
+        await LocationCacheService.startRiderLiveTracking();
+        expect(gps.starts, 1);
+        await gps.positions.close();
+        await Future<void>.delayed(Duration.zero);
+        expect(LocationCacheService.riderLocationStream, isNull);
+        gps.positions = StreamController<Position>.broadcast();
+        await LocationCacheService.startRiderLiveTracking();
+        expect(gps.starts, 2);
+        expect(LocationCacheService.riderLocationStream, isNotNull);
+      } finally {
+        await LocationCacheService.stopRiderLiveTracking();
+        GeolocatorPlatform.instance = original;
+        await gps.positions.close();
+        await gps.status.close();
+        await Supabase.instance.dispose();
+      }
+    },
+  );
+}
