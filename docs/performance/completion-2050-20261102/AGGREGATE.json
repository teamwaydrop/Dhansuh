{
  "sql": "SELECT source,log_attributes['request.method'] AS method,\nCASE WHEN source='edge_logs' THEN CASE WHEN startsWith(log_attributes['request.path'],'/storage/v1/object/sign/') THEN '/storage/[signed_object]' WHEN startsWith(log_attributes['request.path'],'/storage/') THEN '/storage/[object]' ELSE splitByChar('?',log_attributes['request.path'])[1] END ELSE log_attributes['parsed.sql_state_code'] END AS operation,\nCASE WHEN startsWith(log_attributes['request.headers.user_agent'],'Dart/') THEN 'Dart' WHEN startsWith(log_attributes['request.headers.user_agent'],'Deno/') THEN 'Edge/Deno' ELSE 'other' END AS family,\ncount() AS n,countIf(toInt32OrZero(log_attributes['response.status_code'])>=500) AS http5xx,countIf(toInt32OrZero(log_attributes['response.status_code']) BETWEEN 400 AND 499) AS http4xx,\ncountIf(positionCaseInsensitive(event_message,'timeout')>0) AS timeout_texts,\nquantileExact(0.5)(toFloat64OrZero(log_attributes['response.origin_time'])) AS p50_ms,\nquantileExact(0.95)(toFloat64OrZero(log_attributes['response.origin_time'])) AS p95_ms,max(toFloat64OrZero(log_attributes['response.origin_time'])) AS max_ms,\nmin(timestamp) AS first_observed,max(timestamp) AS last_observed\nFROM logs WHERE source IN('edge_logs','postgres_logs','postgrest_logs','realtime_logs')\nGROUP BY source,method,operation,family ORDER BY http5xx DESC,timeout_texts DESC,max_ms DESC LIMIT 110",
