  "query": "SELECT source,\nCASE WHEN source IN ('edge_logs','function_edge_logs') THEN log_attributes['request.method'] ELSE '' END AS method,\nCASE WHEN source='edge_logs' THEN CASE WHEN startsWith(log_attributes['request.path'],'/storage/') THEN '/storage/[object]' ELSE splitByChar('?',log_attributes['request.path'])[1] END WHEN source='function_edge_logs' THEN log_attributes['function_id'] ELSE log_attributes['parsed.sql_state_code'] END AS operation,\nCASE WHEN source='edge_logs' THEN CASE WHEN startsWith(log_attributes['request.headers.user_agent'],'Dart/') THEN 'Dart' WHEN startsWith(log_attributes['request.headers.user_agent'],'Deno/') THEN 'Edge/Deno' WHEN startsWith(log_attributes['request.headers.user_agent'],'pg_net/') THEN 'pg_net' ELSE 'other' END ELSE '' END AS family,\ncount() AS observations,\ncountIf(toInt32OrZero(log_attributes['response.status_code'])>=500) AS http_5xx,\ncountIf(toInt32OrZero(log_attributes['response.status_code']) BETWEEN 400 AND 499) AS http_4xx,\ncountIf(log_attributes['parsed.sql_state_code']='57014' OR positionCaseInsensitive(event_message,'timeout')>0) AS timeout_events,\ncountIf(source='edge_logs' AND toFloat64OrZero(log_attributes['response.origin_time'])>=1000) AS over_1s,\ncountIf(source='edge_logs' AND toFloat64OrZero(log_attributes['response.origin_time'])>=5000) AS over_5s,\nquantileExact(0.50)(toFloat64OrZero(log_attributes['response.origin_time'])) AS p50_ms,\nquantileExact(0.95)(toFloat64OrZero(log_attributes['response.origin_time'])) AS p95_ms,\nmax(toFloat64OrZero(log_attributes['response.origin_time'])) AS max_ms,\nmin(timestamp) AS first_observed,max(timestamp) AS last_observed\nFROM logs WHERE source IN ('edge_logs','postgres_logs','postgrest_logs','realtime_logs','function_edge_logs','function_logs','auth_logs','storage_logs')\nGROUP BY source,method,operation,family\nORDER BY http_5xx DESC,timeout_events DESC,max_ms DESC LIMIT 120",
