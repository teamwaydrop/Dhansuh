{
  "query": "SELECT timestamp,source,\nCASE WHEN source='edge_logs' THEN CASE WHEN startsWith(log_attributes['request.path'],'/storage/') THEN '/storage/[object]' ELSE splitByChar('?',log_attributes['request.path'])[1] END\nWHEN source='postgres_logs' THEN CASE WHEN positionCaseInsensitive(log_attributes['parsed.query'],'pg_stat_statements')>0 THEN 'monitoring_pg_stat_statements' WHEN positionCaseInsensitive(log_attributes['parsed.query'],'list_changes')>0 THEN 'realtime_list_changes' WHEN positionCaseInsensitive(log_attributes['parsed.query'],'get_dispatch_round_status')>0 THEN 'dispatch_round_status' WHEN positionCaseInsensitive(log_attributes['parsed.query'],'riders')>0 THEN 'riders_query' WHEN positionCaseInsensitive(log_attributes['parsed.query'],'orders')>0 THEN 'orders_query' WHEN positionCaseInsensitive(log_attributes['parsed.query'],'chat')>0 THEN 'chat_query' ELSE 'other_SQL' END\nWHEN source='postgrest_logs' THEN CASE WHEN positionCaseInsensitive(event_message,'Thread killed by timeout manager')>0 THEN 'Warp timeout manager' ELSE 'other_timeout' END\nWHEN source='realtime_logs' THEN CASE WHEN positionCaseInsensitive(event_message,'timeout')>0 THEN 'Realtime timeout' ELSE 'Realtime event' END ELSE '' END AS operation,\nCASE WHEN source='postgres_logs' THEN CASE WHEN positionCaseInsensitive(event_message,'statement timeout')>0 THEN 'statement timeout' WHEN positionCaseInsensitive(event_message,'starting background worker')>0 OR positionCaseInsensitive(event_message,'startup')>0 THEN 'startup timeout' WHEN positionCaseInsensitive(event_message,'duplicate key')>0 THEN 'duplicate key' WHEN positionCaseInsensitive(event_message,'null value')>0 THEN 'null violation' ELSE 'other' END ELSE '' END AS error_class,\nlog_attributes['request.method'] AS method,log_attributes['response.status_code'] AS status,\nlog_attributes['response.origin_time'] AS origin_ms,log_attributes['request.headers.content_length'] AS request_bytes,\nCASE WHEN startsWith(log_attributes['request.headers.user_agent'],'Dart/') THEN 'Dart' WHEN startsWith(log_attributes['request.headers.user_agent'],'Deno/') THEN 'Edge/Deno' ELSE 'other' END AS family,\nlog_attributes['parsed.sql_state_code'] AS sqlstate,log_attributes['parsed.backend_type'] AS backend_type,log_attributes['parsed.application_name'] AS application_name,\nextract(log_attributes['parsed.context'],'PL/pgSQL function ([a-zA-Z0-9_]+)') AS function_context,\nextract(event_message,'cron job ([0-9]+)') AS cron_job,\nextract(event_message,'duration: ([0-9.]+) ms') AS sql_duration_ms\nFROM logs WHERE (source='edge_logs' AND (toFloat64OrZero(log_attributes['response.origin_time'])>=5000 OR toInt32OrZero(log_attributes['response.status_code'])>=500 OR (startsWith(log_attributes['request.path'],'/storage/') AND log_attributes['request.method']='POST')))\nOR (source='postgres_logs' AND (log_attributes['parsed.sql_state_code'] IN('57014','23502') OR positionCaseInsensitive(event_message,'timeout')>0))\nOR (source IN('postgrest_logs','realtime_logs') AND positionCaseInsensitive(event_message,'timeout')>0)\nORDER BY timestamp LIMIT 100",
  "window_utc": [
