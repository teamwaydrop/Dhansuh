  "query": "SELECT timestamp,source,\nCASE WHEN source='edge_logs' THEN 'storage_post' WHEN source='postgres_logs' THEN 'duplicate_key' ELSE 'postgrest_timeout' END AS kind,\nCASE WHEN source='edge_logs' THEN CASE WHEN splitByChar('/',log_attributes['request.path'])[5] IN('sign','authenticated','public') THEN splitByChar('/',log_attributes['request.path'])[5] ELSE 'upload' END ELSE '' END AS operation,\nCASE WHEN source='edge_logs' THEN CASE WHEN splitByChar('/',log_attributes['request.path'])[5] IN('sign','authenticated','public') THEN splitByChar('/',log_attributes['request.path'])[6] ELSE splitByChar('/',log_attributes['request.path'])[5] END ELSE '' END AS bucket,\nCASE WHEN source='postgres_logs' THEN extract(event_message,'unique constraint \"([^\"]+)\"') WHEN source='postgrest_logs' AND positionCaseInsensitive(event_message,'Thread killed by timeout manager')>0 THEN 'Warp timeout manager' WHEN source='postgrest_logs' THEN 'other timeout' ELSE '' END AS detail,\nlog_attributes['response.origin_time'] AS origin_ms,\nlog_attributes['response.headers.x_envoy_upstream_service_time'] AS upstream_ms,\nlog_attributes['request.headers.content_length'] AS request_bytes,\nlog_attributes['request.content_length'] AS request_bytes_alternative,\nlog_attributes['response.status_code'] AS status\nFROM logs\nWHERE (source='edge_logs' AND startsWith(log_attributes['request.headers.user_agent'],'Dart/') AND log_attributes['request.method']='POST' AND startsWith(log_attributes['request.path'],'/storage/') AND toFloat64OrZero(log_attributes['response.origin_time'])>5000)\nOR (source='postgres_logs' AND log_attributes['parsed.sql_state_code']='23505')\nOR (source='postgrest_logs' AND positionCaseInsensitive(event_message,'timeout')>0)\nORDER BY timestamp LIMIT 30",
