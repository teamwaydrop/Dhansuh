  "query": "SELECT source,\nCASE WHEN source='edge_logs' THEN log_attributes['request.method'] ELSE '' END AS method,\nCASE WHEN source='edge_logs' THEN CASE WHEN startsWith(log_attributes['request.path'],'/storage/') THEN '/storage/[object]' ELSE splitByChar('?',log_attributes['request.path'])[1] END ELSE log_attributes['parsed.sql_state_code'] END AS path_or_sqlstate,\nCASE WHEN source='edge_logs' THEN CASE WHEN startsWith(log_attributes['request.headers.user_agent'],'Dart/') THEN 'Dart' WHEN startsWith(log_attributes['request.headers.user_agent'],'Deno/') THEN 'Edge/Deno' WHEN startsWith(log_attributes['request.headers.user_agent'],'pg_net/') THEN 'pg_net' ELSE 'other' END ELSE log_attributes['parsed.backend_type'] END AS family,\ncount() AS observations,\ncountIf(toInt32OrZero(log_attributes['response.status_code'])>=500 OR log_attributes['parsed.sql_state_code']='57014' OR positionCaseInsensitive(event_message,'timeout')>0) AS errors_or_timeout_events,\ncountIf(source='edge_logs' AND toFloat64OrZero(log_attributes['response.origin_time'])>=1000) AS over_1s,\ncountIf(source='edge_logs' AND toFloat64OrZero(log_attributes['response.origin_time'])>=5000) AS over_5s,\ncountIf(source='edge_logs' AND toFloat64OrZero(log_attributes['response.origin_time'])>=20000) AS over_20s,\nquantileExact(0.50)(toFloat64OrZero(log_attributes['response.origin_time'])) AS origin_p50_ms,\nquantileExact(0.95)(toFloat64OrZero(log_attributes['response.origin_time'])) AS origin_p95_ms,\nmax(toFloat64OrZero(log_attributes['response.origin_time'])) AS max_origin_ms,\nmin(timestamp) AS first_observed,max(timestamp) AS last_observed\nFROM logs\nWHERE source IN('edge_logs','postgres_logs','postgrest_logs','realtime_logs')\nGROUP BY source,method,path_or_sqlstate,family\nORDER BY errors_or_timeout_events DESC,max_origin_ms DESC LIMIT 100",
