+    String path,
+    Uint8List bytes,
+    String digest,
+    String suffix,
+  ) async {
+    final bucket = client.storage.from('parcel_images');
+    if (await _verified(owner, path, digest)) return bucket.getPublicUrl(path);
+    _checkOwner(owner);
+    try {
+      await bucket.uploadBinary(
+        path,
+        bytes,
+        fileOptions: FileOptions(
